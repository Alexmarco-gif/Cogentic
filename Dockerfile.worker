# ==============================================
# DOCKERFILE - Background Worker
# ==============================================
# Worker service for processing Redis queue jobs

FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
COPY requirements.prod.txt .
RUN pip install --no-cache-dir --default-timeout=180 --retries 10 -r requirements.prod.txt

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose health-check port
EXPOSE 8001

# Liveness probe — worker exposes a tiny HTTP health server
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

# Run worker process
CMD ["python", "worker.py"]
