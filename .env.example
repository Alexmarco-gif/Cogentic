# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# Application
APP_NAME="Cogent API"
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# ==============================================
# DATABASE (Neon PostgreSQL)
# ==============================================

# Format: postgresql+asyncpg://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.aws-eu-west-2.aws.neon.tech/cogent?sslmode=require

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ==============================================
# REDIS (Job Queue & Caching)
# ==============================================

# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Azure Cache for Redis)
# REDIS_URL=rediss://:password@cogent.redis.cache.windows.net:6380/0

REDIS_MAX_CONNECTIONS=10

# ==============================================
# AUTH0 CONFIGURATION
# ==============================================

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.cogent.ai

# Machine-to-Machine (Backend API)
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret

# Claims namespace (MUST match frontend and backend)
AUTH0_CLAIMS_NAMESPACE=https://cogent.ai/claims/

# ==============================================
# OPENAI (Direct — BAA required for HIPAA)
# ==============================================

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# ==============================================
# SIGNAL ACQUISITION
# ==============================================

NEWSAPI_KEY=your-newsapi-key
BING_NEWS_API_KEY=your-bing-news-api-key
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# ==============================================
# AZURE SERVICES
# ==============================================

AZURE_STORAGE_CONNECTION_STRING=your-azure-blob-connection-string
AZURE_STORAGE_CONTAINER_MODELS=ml-models
AZURE_STORAGE_CONTAINER_ARCHIVES=signal-archives
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# ==============================================
# GRAFANA CLOUD (Observability)
# ==============================================

GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=your-instance-id
GRAFANA_CLOUD_API_KEY=your-grafana-cloud-api-key

# ==============================================
# RATE LIMITING
# ==============================================

RATE_LIMIT_AI_PER_USER=30/minute
RATE_LIMIT_AI_PER_ORG=100/minute
RATE_LIMIT_SEARCH_PER_USER=30/minute

# ==============================================
# ML PIPELINE
# ==============================================

ML_MODEL_STORAGE=local
# Options: local (dev), azure_blob (prod)
ML_MODEL_LOCAL_PATH=./backend/ml/models/artifacts
ML_RETRAIN_SCHEDULE=weekly

# ==============================================
# DATA RETENTION (Compliance)
# ==============================================

SIGNAL_RETENTION_DAYS=90
CHAT_RETENTION_DAYS=90
SEARCH_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

#
