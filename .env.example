# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# Application
APP_NAME="Cogent API"
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# ==============================================
# DATABASE (Neon PostgreSQL)
# ==============================================

# Format: postgresql+asyncpg://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.aws-eu-west-2.aws.neon.tech/cogent?sslmode=require

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ==============================================
# REDIS (Job Queue & Caching)
# ==============================================

# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Azure Cache for Redis)
# REDIS_URL=rediss://:password@cogent.redis.cache.windows.net:6380/0

REDIS_MAX_CONNECTIONS=10

# ==============================================
# AUTH0 CONFIGURATION
# ==============================================

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.cogent-ai.com

# Machine-to-Machine (Backend API)
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret

#