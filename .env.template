# ==============================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git - it contains secrets!

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Environment (development, preprod, production)
ENVIRONMENT=development
DEBUG=true

# Application
APP_NAME="Cogent API"
SECRET_KEY=generate-with-openssl-rand-hex-32

# ==============================================
# DATABASE (Neon PostgreSQL)
# ==============================================

# Format: postgresql+asyncpg://user:password@host:port/database?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?ssl=require

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ==============================================
# REDIS (Job Queue & Caching)
# ==============================================

# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Azure Cache for Redis)
# REDIS_URL=rediss://:password@your-redis.redis.cache.windows.net:6380/0

REDIS_MAX_CONNECTIONS=10

# ==============================================
# AUTH0 CONFIGURATION
# ==============================================

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.cogent-ai.com

# Machine-to-Machine (Backend API)
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret

# Optional: Webhook signature verification
# AUTH0_WEBHOOK_SECRET=your-webhook-secret

# ==============================================
# OBSERVABILITY (Optional - Phase 2+)
# ==============================================

# Sentry (Error tracking)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Logtail (Log aggregation)
# LOGTAIL_TOKEN=your-token

# PostHog (Product analytics - Phase 3)
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://app.posthog.com

# ==============================================
# CORS CONFIGURATION
# ==============================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# FUTURE SERVICES (Not implemented yet)
# ==============================================

# Azure Blob Storage (Document storage - Phase 3)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=cogent-documents

# OpenAI (AI processing - Phase 3)
