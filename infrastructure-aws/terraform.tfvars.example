aws_region  = "eu-west-2"
environment = "staging"
project_name = "cogent"

# Add your ACM certificate ARN after creating/importing a cert in the same region.
# HTTPS is required by default. Use allow_http_bootstrap=true only for a temporary
# first apply before DNS/certificates are ready.
certificate_arn = "arn:aws:acm:eu-west-2:123456789012:certificate/replace-me"
# allow_http_bootstrap = true

# Set these after DNS is ready. Until then, Terraform uses the ALB DNS name.
# frontend_domain_name = "staging.cogent.ai"
# backend_domain_name  = "api-staging.cogent.ai"

db_instance_class = "db.t4g.medium"
db_engine_version = "16.13"
db_password       = "replace-with-a-generated-32-character-password"
redis_node_type   = "cache.t4g.small"
redis_auth_token  = "replace-with-a-generated-32-character-token"

frontend_desired_count  = 1
backend_desired_count   = 2
worker_desired_count    = 1
scheduler_desired_count = 1

tags = {
  Owner = "cogent"
}
