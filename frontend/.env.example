# =============================================================================
# Cogent — Frontend Environment Variables
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
#   cp .env.example .env.local

# ── Auth0 ────────────────────────────────────────────────────────────────────
AUTH0_SECRET=generate-a-random-32-byte-hex     # openssl rand -hex 32
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-regular-web-app-client-id
AUTH0_CLIENT_SECRET=your-regular-web-app-client-secret
AUTH0_AUDIENCE=https://your-api-audience

# ── Backend API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ── Auth0 Management (M2M — used by webhook handler) ────────────────────────
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret
AUTH0_M2M_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# ── Webhook verification ────────────────────────────────────────────────────
AUTH0_WEBHOOK_SECRET=your-webhook-hmac-secret
